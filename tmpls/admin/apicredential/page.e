{{ template "header" .}}
<h1>Management API credentials</h1><form method="get" action="apicredential"><input type="hidden" name="action" value="topics"><label>Advertiser ID <input type="number" min="1" name="adv_id" value="{{.Other.APIAdvID}}" required></label><button type="submit">View</button></form>{{with .Other.IssuedToken}}<div class="alert alert-warning"><strong>Token shown once:</strong><br><code>{{.}}</code></div>{{end}}<p>Use the Chinese administration view for full lifecycle controls.</p><table class="table"><thead><tr><th>ID</th><th>Name</th><th>Public ID</th><th>Expiry</th><th>Status</th></tr></thead><tbody>{{range .Other.APICredentials}}<tr><td>{{.ID}}</td><td>{{.Name}}</td><td><code>{{.PublicID}}</code></td><td>{{.ExpiresAt}}</td><td>{{if .RevokedAt}}Revoked{{else}}Active{{end}}</td></tr>{{else}}<tr><td colspan="5">No credentials.</td></tr>{{end}}</tbody></table>{{ template "footer" .}}
