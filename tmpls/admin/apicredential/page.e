{{ template "header" .}}
<h1>Management API Credentials</h1>
<form class="form-inline" method="get" action="apicredential"><input type="hidden" name="action" value="topics"><label>Advertiser ID <input class="form-control" type="number" min="1" name="adv_id" value="{{.Other.APIAdvID}}" required></label> <button class="btn btn-secondary" type="submit">View</button></form>
{{with .Other.IssuedToken}}<div class="alert alert-warning"><strong>The token is shown only once. Save it now:</strong><br><code>{{.}}</code></div>{{end}}
<h2>Issue Credential</h2><form method="post" action="apicredential?action=issue"><input type="hidden" name="adv_id" value="{{.Other.APIAdvID}}"><div class="form-group"><label>Name</label><input class="form-control" name="credential_name" maxlength="128" required></div><div class="form-group"><label>Scopes</label>{{range .Other.APIScopes}}<div class="form-check"><label><input type="checkbox" name="scope" value="{{.value}}"> {{.label}} (<code>{{.value}}</code>)</label></div>{{end}}</div><div class="form-group"><label>Validity (Days)</label><input class="form-control" type="number" name="expires_days" min="1" max="365" value="90" required></div><div class="form-group"><label>Reason</label><input class="form-control" name="reason" maxlength="255" required></div><button class="btn btn-primary" type="submit">Issue</button></form>
<h2>Existing Credentials</h2><table class="table table-striped"><thead><tr><th>ID</th><th>Name</th><th>Public Identifier</th><th>Scopes</th><th>Expires</th><th>Actions</th></tr></thead><tbody>{{range .Other.APICredentials}}<tr><td>{{.ID}}</td><td>{{.Name}}</td><td><code>{{.PublicID}}</code></td><td>{{range .Scopes}}<code>{{.}}</code><br>{{end}}</td><td>{{.ExpiresAt}}</td><td>{{if .RevokedAt}}Revoked{{else}}<form method="post" action="apicredential?action=rotate"><input type="hidden" name="adv_id" value="{{$.Other.APIAdvID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input name="reason" maxlength="255" placeholder="Rotation reason" required><button class="btn btn-sm btn-warning" type="submit">Rotate</button></form><form method="post" action="apicredential?action=revoke"><input type="hidden" name="adv_id" value="{{$.Other.APIAdvID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input name="reason" maxlength="255" placeholder="Revocation reason" required><button class="btn btn-sm btn-danger" type="submit">Revoke</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="6">No credentials.</td></tr>{{end}}</tbody></table>
{{ template "footer" .}}
