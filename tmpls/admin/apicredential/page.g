{{ template "header" .}}
<h1>管理 API 凭证</h1>
<form class="form-inline" method="get" action="apicredential"><input type="hidden" name="action" value="topics"><label>广告主 ID <input class="form-control" type="number" min="1" name="adv_id" value="{{.Other.APIAdvID}}" required></label> <button class="btn btn-secondary" type="submit">查看</button></form>
{{with .Other.IssuedToken}}<div class="alert alert-warning"><strong>令牌只显示一次，请立即保存：</strong><br><code>{{.}}</code></div>{{end}}
<h2>签发凭证</h2><form method="post" action="apicredential?action=issue"><input type="hidden" name="adv_id" value="{{.Other.APIAdvID}}"><div class="form-group"><label>名称</label><input class="form-control" name="credential_name" maxlength="128" required></div><div class="form-group"><label>权限</label>{{range .Other.APIScopes}}<div class="form-check"><label><input type="checkbox" name="scope" value="{{.value}}"> {{.label}}（<code>{{.value}}</code>）</label></div>{{end}}</div><div class="form-group"><label>有效期（天）</label><input class="form-control" type="number" name="expires_days" min="1" max="365" value="90" required></div><div class="form-group"><label>原因</label><input class="form-control" name="reason" maxlength="255" required></div><button class="btn btn-primary" type="submit">签发</button></form>
<h2>现有凭证</h2><table class="table table-striped"><thead><tr><th>ID</th><th>名称</th><th>公开标识</th><th>权限</th><th>到期</th><th>操作</th></tr></thead><tbody>{{range .Other.APICredentials}}<tr><td>{{.ID}}</td><td>{{.Name}}</td><td><code>{{.PublicID}}</code></td><td>{{range .Scopes}}<code>{{.}}</code><br>{{end}}</td><td>{{.ExpiresAt}}</td><td>{{if .RevokedAt}}已撤销{{else}}<form method="post" action="apicredential?action=rotate"><input type="hidden" name="adv_id" value="{{$.Other.APIAdvID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input name="reason" maxlength="255" placeholder="轮换原因" required><button class="btn btn-sm btn-warning" type="submit">轮换</button></form><form method="post" action="apicredential?action=revoke"><input type="hidden" name="adv_id" value="{{$.Other.APIAdvID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input name="reason" maxlength="255" placeholder="撤销原因" required><button class="btn btn-sm btn-danger" type="submit">撤销</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="6">暂无凭证。</td></tr>{{end}}</tbody></table>
{{ template "footer" .}}
