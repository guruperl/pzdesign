{{ template "header" .}}
<h1 class="h2">Traffic quality review</h1><p class="text-muted">Rule decisions remain separate from infrastructure errors. Blocking requires complete evidence, human review, a named version, and rollback.</p>{{with .Other.QualityMessage}}<div class="alert alert-success">{{.}}</div>{{end}}
<div class="card mb-3"><div class="card-body"><h2 class="h5">Review scope</h2><form class="form-inline mb-2" method="get" action="trafficquality"><input type="hidden" name="action" value="topicsAdv"><label>Advertiser ID <input class="form-control ml-2" type="number" min="1" name="adv_id" required></label><button class="btn btn-outline-danger ml-2" type="submit">Open</button></form><form class="form-inline mb-2" method="get" action="trafficquality"><input type="hidden" name="action" value="topicsPub"><label>Publisher ID <input class="form-control ml-2" type="number" min="1" name="pub_id" required></label><button class="btn btn-outline-info ml-2" type="submit">Open</button></form><form class="form-inline" method="get" action="trafficquality"><input type="hidden" name="action" value="topicsPartner"><label>Partner ID <input class="form-control ml-2" type="number" min="1" name="partner_id" required></label><button class="btn btn-outline-secondary ml-2" type="submit">Open</button></form></div></div>
<div class="card mb-3"><div class="card-body"><h2 class="h5">Create rule draft</h2><form method="post" action="trafficquality?action=createRule">{{.Other.CSRFInput}}<div class="form-row"><input class="form-control col" name="rule_key" placeholder="rule key" pattern="[a-z][a-z0-9_.-]{2,63}" required><select class="form-control col" name="signal"><option>Replay</option><option>ImpossibleSequence</option><option>InvalidOriginApp</option><option>MalformedIdentity</option><option>AbnormalRate</option><option>AbnormalCTR</option><option>Automation</option><option>PartnerPolicy</option></select><select class="form-control col" name="rule_action"><option>Observe</option><option>Flag</option><option>Throttle</option><option>Reject</option><option>Quarantine</option></select><select class="form-control col" name="scope_type"><option>Global</option><option>Advertiser</option><option>Publisher</option><option>Partner</option></select><input class="form-control col" type="number" min="0" name="scope_id" value="0" required></div><div class="form-row mt-2"><input class="form-control col" type="number" min="0" step="0.000001" name="threshold" placeholder="threshold" required><input class="form-control col" type="number" min="1" max="2592000" name="window_seconds" value="60" required><input class="form-control col" name="reason_code" placeholder="reason code" pattern="[a-z][a-z0-9_.-]{2,63}" required><input class="form-control col" type="number" min="1" max="720" name="evidence_hours" value="24" required><input class="form-control col" type="number" min="365" max="2555" name="aggregate_days" value="400" required><input class="form-control col" type="number" min="0" max="10000" name="false_positive_bps" value="100" required></div><input class="form-control mt-2" name="reason" maxlength="500" placeholder="change reason" required><button class="btn btn-primary mt-2" type="submit">Save draft</button></form></div></div>
<h2 class="h4">Rule versions</h2><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Rule</th><th>Signal</th><th>Action</th><th>Scope</th><th>Mode</th><th>Rollout</th></tr></thead><tbody>{{range .Other.QualityRules}}<tr><td>{{.ID}}</td><td><code>{{.Key}}@{{.Version}}</code></td><td>{{.Signal}}</td><td>{{.Action}}</td><td>{{.Scope.Type}} {{.Scope.ID}}</td><td>{{.Mode}}</td><td><form method="post" action="trafficquality?action=setMode">{{$.Other.CSRFInput}}<input type="hidden" name="rule_id" value="{{.ID}}"><input type="hidden" name="expected_mode" value="{{.Mode}}"><select name="next_mode"><option>Observe</option><option>Canary</option><option>Active</option><option>Disabled</option></select><input type="number" name="canary_bps" min="0" max="10000" value="0"><input name="reason" maxlength="500" placeholder="reason" required><button class="btn btn-sm btn-outline-primary" type="submit">Update</button></form></td></tr>{{else}}<tr><td colspan="7">No rules.</td></tr>{{end}}</tbody></table>
<h2 class="h4">Rule health, last 24 hours</h2><table class="table table-sm"><thead><tr><th>Rule</th><th>Decisions / matched / enforced</th><th>Valid / invalid</th><th>Appeals / upheld</th><th>False positives</th><th>Recommendation</th></tr></thead><tbody>{{range .Other.QualityHealth}}<tr><td><code>{{.RuleKey}}@{{.RuleVersion}}</code></td><td>{{.Decisions}} / {{.Matched}} / {{.Enforced}}</td><td>{{.ValidTraffic}} / {{.InvalidTraffic}}</td><td>{{.Appeals}} / {{.AppealsUpheld}}</td><td>{{.FalsePositiveBasisPoints}} bp (limit {{.FalsePositiveLimitBPS}})</td><td>{{if .RollbackRecommended}}<span class="badge badge-danger">Rollback recommended</span>{{else}}Normal{{end}}</td></tr>{{else}}<tr><td colspan="6">No rule-health data.</td></tr>{{end}}</tbody></table>
<h2 class="h4">Review cases</h2><table class="table table-sm"><thead><tr><th>Case</th><th>Rule</th><th>Evidence</th><th>Action</th><th>Status</th><th>Review</th></tr></thead><tbody>{{range .Other.QualityCases}}<tr><td>#{{.ID}}</td><td><code>{{.RuleKey}}@{{.RuleVersion}}</code></td><td>{{.Signal}} {{printf "%.6f" .ObservedValue}} / {{printf "%.6f" .Threshold}}; {{.Evidence}}{{if .SafeSummary.Valid}}: {{.SafeSummary.String}}{{end}}</td><td>{{.ConfiguredAction}} → {{.AppliedAction}}</td><td>{{.Status}} v{{.Version}}</td><td>{{if eq .Status "Open"}}<form method="post" action="trafficquality?action=resolve">{{$.Other.CSRFInput}}<input type="hidden" name="case_id" value="{{.ID}}"><input type="hidden" name="case_version" value="{{.Version}}"><input type="hidden" name="scope_type" value="{{.Scope.Type}}"><input type="hidden" name="scope_id" value="{{.Scope.ID}}"><select name="resolution"><option>ValidTraffic</option><option>InvalidTraffic</option></select><input name="reason" maxlength="500" placeholder="reason" required><button type="submit">Resolve</button></form>{{else if eq .Status "Appealed"}}<form method="post" action="trafficquality?action=resolveAppeal">{{$.Other.CSRFInput}}<input type="hidden" name="case_id" value="{{.ID}}"><input type="hidden" name="case_version" value="{{.Version}}"><input type="hidden" name="scope_type" value="{{.Scope.Type}}"><input type="hidden" name="scope_id" value="{{.Scope.ID}}"><select name="appeal_result"><option value="upheld">Uphold</option><option value="denied">Deny</option></select><input name="reason" maxlength="500" required><button type="submit">Resolve appeal</button></form>{{else if eq .Status "InvalidTraffic"}}<form method="post" action="trafficquality?action=enforce">{{$.Other.CSRFInput}}<input type="hidden" name="decision_id" value="{{.DecisionID}}"><input type="hidden" name="scope_type" value="{{.Scope.Type}}"><input type="hidden" name="scope_id" value="{{.Scope.ID}}"><select name="enforcement_action"><option>Throttle</option><option>Reject</option><option>Quarantine</option></select><input type="number" name="canary_bps" min="0" max="10000" value="100"><input type="number" name="ttl_hours" min="1" max="720" value="24"><input name="reason" maxlength="500" required><button type="submit">Canary</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="6">No cases in this scope.</td></tr>{{end}}</tbody></table>
<h2 class="h4">Enforcement history</h2><table class="table table-sm"><tbody>{{range .Other.QualityEnforcements}}<tr><td>#{{.ID}}</td><td>{{.Action}}</td><td>{{.State}}</td><td>{{.CanaryBasisPoints}} bp</td><td>{{.ExpiresAt}}</td><td>{{if or (eq .State "Active") (eq .State "Canary")}}<form method="post" action="trafficquality?action=rollback">{{$.Other.CSRFInput}}<input type="hidden" name="enforcement_id" value="{{.ID}}"><input type="hidden" name="scope_type" value="{{.Scope.Type}}"><input type="hidden" name="scope_id" value="{{.Scope.ID}}"><input name="reason" maxlength="500" required><button class="btn btn-sm btn-danger" type="submit">Rollback</button></form>{{end}}</td></tr>{{else}}<tr><td>No enforcement history.</td></tr>{{end}}</tbody></table>
{{ template "footer" .}}
