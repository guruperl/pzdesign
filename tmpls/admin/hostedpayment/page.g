{{template "header" .}}
<h1 class="h3">托管资金与结算运营</h1><p class="text-muted">此页面只处理账单、授权状态、不透明服务商标识和净额对账。卡号、银行账号、签名、API 密钥和原始回调正文不得进入 W8M 页面、数据库、日志或工单。</p>
{{if .Other.PaymentMessage}}<div class="alert alert-success">{{.Other.PaymentMessage}}</div>{{end}}
<form method="get" action="hostedpayment"><input type="hidden" name="action" value="topics"><label>账户类型</label><select name="party_type"><option value="">全部</option><option value="advertiser">广告主</option><option value="publisher">媒体方</option></select><label>账户 ID</label><input type="number" min="1" name="party_id"><button class="btn btn-sm btn-outline-secondary" type="submit">按账户查看</button></form>
<hr><h2 class="h4">账户绑定复核</h2><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>账户</th><th>类型 / 标识</th><th>国家或地区</th><th>就绪 / 状态</th><th>复核</th></tr></thead><tbody>{{range .Other.PaymentBindings}}<tr><td>{{.ID}}</td><td>{{.PartyType}} {{.PartyID}}</td><td>{{.Kind}}<br><code>{{.ProviderToken}}</code></td><td>{{if .Country.Valid}}{{.Country.String}}{{else}}—{{end}}</td><td>{{.ProviderReady}} / {{.Status}}</td><td>{{if eq .Status "Ready"}}<form method="post" action="hostedpayment?action=approveBinding">{{$.Other.CSRFInput}}<input type="hidden" name="binding_id" value="{{.ID}}"><input type="hidden" name="binding_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="独立复核依据" required><button class="btn btn-sm btn-primary" type="submit">核准绑定</button></form>{{else}}—{{end}}</td></tr>{{else}}<tr><td colspan="6">暂无绑定。</td></tr>{{end}}</tbody></table>
<div class="row"><div class="col-lg-6"><h2 class="h4">建立媒体方打款申请</h2><form method="post" action="hostedpayment?action=proposePayout">{{.Other.CSRFInput}}<input class="form-control" type="number" min="1" name="pub_id" placeholder="媒体方 ID" required><input class="form-control" type="number" min="1" name="statement_id" placeholder="Confirmed 账单 ID" required><input class="form-control" name="amount" placeholder="USD 金额（精确到美分）" required><input class="form-control" name="request_key" maxlength="128" placeholder="幂等请求号" required><input class="form-control" name="reason" maxlength="500" placeholder="申请原因" required><button class="btn btn-primary" type="submit">建立打款申请</button></form></div><div class="col-lg-6"><h2 class="h4">建立广告主退款申请</h2><form method="post" action="hostedpayment?action=proposeRefund">{{.Other.CSRFInput}}<input class="form-control" type="number" min="1" name="adv_id" placeholder="广告主 ID" required><input class="form-control" type="number" min="1" name="statement_id" placeholder="账单 ID" required><input class="form-control" type="number" min="1" name="parent_operation_id" placeholder="成功付款操作 ID" required><input class="form-control" name="amount" placeholder="USD 退款金额" required><input class="form-control" name="request_key" maxlength="128" placeholder="幂等请求号" required><input class="form-control" name="reason" maxlength="500" placeholder="退款依据" required><button class="btn btn-outline-primary" type="submit">建立退款申请</button></form></div></div>
<h2 class="h4 mt-4">资金操作</h2><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>账户 / 账单</th><th>类型 / 金额</th><th>状态</th><th>控制</th></tr></thead><tbody>{{range .Other.PaymentOperations}}<tr><td>{{.ID}}</td><td>{{.PartyType}} {{.PartyID}} / #{{.StatementID}}</td><td>{{.Kind}} / {{.Amount}} {{.Currency}}</td><td>{{.Status}} (v{{.Version}}){{if .FailureCode.Valid}}<br>{{.FailureCode.String}}{{end}}</td><td>{{if eq .Status "Proposed"}}<form method="post" action="hostedpayment?action=approveOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="独立复核依据" required><button class="btn btn-sm btn-primary">核准</button></form>{{end}}{{if eq .Status "Approved"}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-success">执行</button></form>{{end}}{{if eq .Status "Submitting"}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-outline-warning">按原幂等键恢复提交</button></form>{{end}}{{if or (eq .Status "Proposed") (and (eq .Status "Approved") (eq .AttemptCount 0)) (and (eq .Kind "Funding") (or (eq .Status "Submitted") (eq .Status "Canceling")))}}<form method="post" action="hostedpayment?action=cancelOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="取消依据" required><button class="btn btn-sm btn-outline-secondary">{{if eq .Status "Canceling"}}继续取消{{else}}取消{{end}}</button></form>{{end}}<form method="post" action="hostedpayment?action=reconcile">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input name="reason" maxlength="500" placeholder="对账原因" required><button class="btn btn-sm btn-outline-info">对账</button></form></td></tr>{{else}}<tr><td colspan="5">暂无资金操作。</td></tr>{{end}}</tbody></table></div>
<h2 class="h4 mt-4">对账与异常</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>ID</th><th>类别</th><th>操作</th><th>金额 / 手续费 / 净额</th><th>状态</th><th>处置</th></tr></thead><tbody>{{range .Other.PaymentReconciliations}}<tr><td>{{.ID}}</td><td>{{.Category}}</td><td>{{if .OperationID.Valid}}#{{.OperationID.Int64}}{{else}}—{{end}}</td><td>{{.Amount}} / {{.Fee}} / {{.Net}} {{.Currency}}</td><td>{{.Status}}<br><small>{{.Reason}}</small></td><td>{{if eq .Status "Unresolved"}}<form method="post" action="hostedpayment?action=resolveReconciliation">{{$.Other.CSRFInput}}<input type="hidden" name="reconciliation_id" value="{{.ID}}"><input name="reason" maxlength="500" placeholder="独立处置依据" required><button class="btn btn-sm btn-outline-primary">复核关闭</button></form>{{else}}—{{end}}</td></tr>{{else}}<tr><td colspan="6">暂无对账记录。</td></tr>{{end}}</tbody></table></div>
<h2 class="h4 mt-4">密钥引用就绪检查</h2><form method="post" action="hostedpayment?action=secretReadiness">{{.Other.CSRFInput}}<input name="reason" maxlength="500" placeholder="检查原因" required><button class="btn btn-sm btn-outline-secondary">检查引用（不显示密钥）</button></form>{{with .Other.PaymentSecretReadiness}}<p>API 引用：{{.APIKeyPresent}}；当前回调引用：{{.WebhookSecretPresent}}；旧回调引用：{{.PreviousWebhookPresent}}；模式匹配：{{.ModeMatches}}</p>{{end}}
{{template "footer" .}}
