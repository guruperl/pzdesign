{{template "header" .}}
<h1 class="h3">Hosted Funding and Settlement Operations</h1><p class="text-muted">This page handles only statements, authorization status, opaque provider identifiers, and net reconciliation. Card numbers, bank-account numbers, signatures, API keys, and raw callback bodies must never enter W8M pages, databases, logs, or tickets.</p>
{{if .Other.PaymentMessage}}<div class="alert alert-success">{{.Other.PaymentMessage}}</div>{{end}}
<form method="get" action="hostedpayment"><input type="hidden" name="action" value="topics"><label>Account Type</label><select name="party_type"><option value="">All</option><option value="advertiser">Advertiser</option><option value="publisher">Publisher</option></select><label>Account ID</label><input type="number" min="1" name="party_id"><button class="btn btn-sm btn-outline-secondary" type="submit">View by Account</button></form>
<hr><h2 class="h4">Account Binding Review</h2><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Account</th><th>Type / Identifier</th><th>Country or Region</th><th>Ready / Status</th><th>Review</th></tr></thead><tbody>{{range .Other.PaymentBindings}}<tr><td>{{.ID}}</td><td>{{.PartyType}} {{.PartyID}}</td><td>{{.Kind}}<br><code>{{.ProviderToken}}</code></td><td>{{if .Country.Valid}}{{.Country.String}}{{else}}—{{end}}</td><td>{{.ProviderReady}} / {{.Status}}</td><td>{{if eq .Status "Ready"}}<form method="post" action="hostedpayment?action=approveBinding">{{$.Other.CSRFInput}}<input type="hidden" name="binding_id" value="{{.ID}}"><input type="hidden" name="binding_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="Basis for independent review" required><button class="btn btn-sm btn-primary" type="submit">Approve Binding</button></form>{{else}}—{{end}}</td></tr>{{else}}<tr><td colspan="6">No bindings.</td></tr>{{end}}</tbody></table>
<div class="row"><div class="col-lg-6"><h2 class="h4">Create Publisher Payout Request</h2><form method="post" action="hostedpayment?action=proposePayout">{{.Other.CSRFInput}}<input class="form-control" type="number" min="1" name="pub_id" placeholder="Publisher ID" required><input class="form-control" type="number" min="1" name="statement_id" placeholder="Confirmed statement ID" required><input class="form-control" name="amount" placeholder="USD amount (exact to the cent)" required><input class="form-control" name="request_key" maxlength="128" placeholder="Idempotency request key" required><input class="form-control" name="reason" maxlength="500" placeholder="Request reason" required><button class="btn btn-primary" type="submit">Create Payout Request</button></form></div><div class="col-lg-6"><h2 class="h4">Create Advertiser Refund Request</h2><form method="post" action="hostedpayment?action=proposeRefund">{{.Other.CSRFInput}}<input class="form-control" type="number" min="1" name="adv_id" placeholder="Advertiser ID" required><input class="form-control" type="number" min="1" name="statement_id" placeholder="Statement ID" required><input class="form-control" type="number" min="1" name="parent_operation_id" placeholder="Successful payment operation ID" required><input class="form-control" name="amount" placeholder="USD refund amount" required><input class="form-control" name="request_key" maxlength="128" placeholder="Idempotency request key" required><input class="form-control" name="reason" maxlength="500" placeholder="Refund basis" required><button class="btn btn-outline-primary" type="submit">Create Refund Request</button></form></div></div>
<h2 class="h4 mt-4">Funding Operations</h2><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Account / Statement</th><th>Type / Amount</th><th>Status</th><th>Controls</th></tr></thead><tbody>{{range .Other.PaymentOperations}}<tr><td>{{.ID}}</td><td>{{.PartyType}} {{.PartyID}} / #{{.StatementID}}</td><td>{{.Kind}} / {{.Amount}} {{.Currency}}</td><td>{{.Status}} (v{{.Version}}){{if .FailureCode.Valid}}<br>{{.FailureCode.String}}{{end}}</td><td>{{if eq .Status "Proposed"}}<form method="post" action="hostedpayment?action=approveOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="Basis for independent review" required><button class="btn btn-sm btn-primary">Approve</button></form>{{end}}{{if eq .Status "Approved"}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-success">Execute</button></form>{{end}}{{if eq .Status "Submitting"}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-outline-warning">Resume Submission with Original Idempotency Key</button></form>{{end}}{{if or (eq .Status "Proposed") (and (eq .Status "Approved") (eq .AttemptCount 0)) (and (eq .Kind "Funding") (or (eq .Status "Submitted") (eq .Status "Canceling")))}}<form method="post" action="hostedpayment?action=cancelOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="Cancellation basis" required><button class="btn btn-sm btn-outline-secondary">{{if eq .Status "Canceling"}}Continue Cancellation{{else}}Cancel{{end}}</button></form>{{end}}<form method="post" action="hostedpayment?action=reconcile">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input name="reason" maxlength="500" placeholder="Reconciliation reason" required><button class="btn btn-sm btn-outline-info">Reconcile</button></form></td></tr>{{else}}<tr><td colspan="5">No funding operations.</td></tr>{{end}}</tbody></table></div>
<h2 class="h4 mt-4">Reconciliation and Exceptions</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>ID</th><th>Category</th><th>Operation</th><th>Amount / Fee / Net</th><th>Status</th><th>Disposition</th></tr></thead><tbody>{{range .Other.PaymentReconciliations}}<tr><td>{{.ID}}</td><td>{{.Category}}</td><td>{{if .OperationID.Valid}}#{{.OperationID.Int64}}{{else}}—{{end}}</td><td>{{.Amount}} / {{.Fee}} / {{.Net}} {{.Currency}}</td><td>{{.Status}}<br><small>{{.Reason}}</small></td><td>{{if eq .Status "Unresolved"}}<form method="post" action="hostedpayment?action=resolveReconciliation">{{$.Other.CSRFInput}}<input type="hidden" name="reconciliation_id" value="{{.ID}}"><input name="reason" maxlength="500" placeholder="Basis for independent disposition" required><button class="btn btn-sm btn-outline-primary">Review and Close</button></form>{{else}}—{{end}}</td></tr>{{else}}<tr><td colspan="6">No reconciliation records.</td></tr>{{end}}</tbody></table></div>
<h2 class="h4 mt-4">Secret-Reference Readiness Check</h2><form method="post" action="hostedpayment?action=secretReadiness">{{.Other.CSRFInput}}<input name="reason" maxlength="500" placeholder="Check reason" required><button class="btn btn-sm btn-outline-secondary">Check References (Do Not Display Secrets)</button></form>{{with .Other.PaymentSecretReadiness}}<p>API reference: {{.APIKeyPresent}}; current webhook reference: {{.WebhookSecretPresent}}; previous webhook reference: {{.PreviousWebhookPresent}}; mode matches: {{.ModeMatches}}</p>{{end}}
{{template "footer" .}}
