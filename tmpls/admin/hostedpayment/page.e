{{template "header" .}}<h1 class="h3">Hosted funding and payout operations</h1><p class="text-muted">This surface handles statements, authorization state, opaque provider IDs, and reconciliation only. Never enter card, bank, API-key, raw-signature, or raw-webhook data.</p>{{if .Other.PaymentMessage}}<div class="alert alert-success">{{.Other.PaymentMessage}}</div>{{end}}<h2 class="h4">Bindings</h2><table class="table table-sm"><thead><tr><th>ID</th><th>Party</th><th>Kind / token</th><th>Country</th><th>Ready / status</th><th>Review</th></tr></thead><tbody>{{range .Other.PaymentBindings}}<tr><td>{{.ID}}</td><td>{{.PartyType}} {{.PartyID}}</td><td>{{.Kind}} / <code>{{.ProviderToken}}</code></td><td>{{if .Country.Valid}}{{.Country.String}}{{else}}—{{end}}</td><td>{{.ProviderReady}} / {{.Status}}</td><td>{{if eq .Status "Ready"}}<form method="post" action="hostedpayment?action=approveBinding">{{$.Other.CSRFInput}}<input type="hidden" name="binding_id" value="{{.ID}}"><input type="hidden" name="binding_version" value="{{.Version}}"><input name="reason" maxlength="500" required><button class="btn btn-sm btn-primary">Approve</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="6">No bindings.</td></tr>{{end}}</tbody></table><h2 class="h4">Operations</h2><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Party / statement</th><th>Kind / amount</th><th>Status</th><th>Control</th></tr></thead><tbody>{{range .Other.PaymentOperations}}<tr><td>{{.ID}}</td><td>{{.PartyType}} {{.PartyID}} / #{{.StatementID}}</td><td>{{.Kind}} / {{.Amount}} {{.Currency}}</td><td>{{.Status}}</td><td>{{if eq .Status "Proposed"}}<form method="post" action="hostedpayment?action=approveOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><input name="reason" maxlength="500" required><button class="btn btn-sm btn-primary">Approve</button></form>{{end}}{{if eq .Status "Approved"}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-success">Execute</button></form>{{end}}{{if eq .Status "Submitting"}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-outline-warning">Recover with original key</button></form>{{end}}{{if or (eq .Status "Proposed") (and (eq .Status "Approved") (eq .AttemptCount 0)) (and (eq .Kind "Funding") (or (eq .Status "Submitted") (eq .Status "Canceling")))}}<form method="post" action="hostedpayment?action=cancelOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="Cancellation evidence" required><button class="btn btn-sm btn-outline-secondary">{{if eq .Status "Canceling"}}Continue cancellation{{else}}Cancel{{end}}</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="5">No operations.</td></tr>{{end}}</tbody></table><p>Use the Chinese operator view for proposal, reconciliation, and secret-readiness forms; both language surfaces enforce the same permissions and state machine.</p>{{template "footer" .}}
