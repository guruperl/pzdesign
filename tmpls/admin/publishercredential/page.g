{{template "header" .}}
<h1>流量方请求凭证</h1><form class="form-inline" method="get" action="publishercredential"><input type="hidden" name="action" value="topics"><label>流量方 ID <input class="form-control" type="number" min="1" name="pub_id" value="{{.Other.PublisherCredentialPubID}}" required></label> <button class="btn btn-secondary" type="submit">查看</button></form>
{{with .Other.IssuedPublisherPrivateValue}}<div class="alert alert-warning"><strong>私密凭证只显示一次，请立即复制：</strong><br><code>{{.}}</code></div>{{end}}
{{if .Other.PublisherCredentialListUnavailable}}<div class="alert alert-danger">凭证已签发，但元数据列表暂时无法刷新。请先安全保存上方私密值。</div>{{end}}
{{if .Other.PublisherCredentialPubID}}<h2>签发凭证</h2><form method="post" action="publishercredential?action=issue" autocomplete="off">{{.Other.CSRFInput}}<input type="hidden" name="pub_id" value="{{.Other.PublisherCredentialPubID}}"><input class="form-control" type="number" min="1" name="site_id" placeholder="已审核的 App 站点 ID" required><input class="form-control" name="credential_name" maxlength="128" placeholder="名称" required><input class="form-control" type="number" name="expires_days" min="1" max="365" value="90" required><input class="form-control" name="reason" maxlength="255" placeholder="操作原因" required><button class="btn btn-primary" type="submit">签发</button></form>
<h2>现有凭证</h2><table class="table table-striped"><thead><tr><th>ID</th><th>App 站点</th><th>名称 / 公开标识</th><th>到期</th><th>状态 / 操作</th></tr></thead><tbody>{{range .Other.PublisherCredentials}}<tr><td>{{.ID}}</td><td>{{.SiteID}}</td><td>{{.Name}}<br><code>{{.PublicID}}</code></td><td>{{.ExpiresAt}}</td><td>{{if .RevokedAt}}已撤销{{else if .RotatedAt}}已轮换{{else}}生效中{{end}}{{if not .RevokedAt}}<form method="post" action="publishercredential?action=rotate" autocomplete="off">{{$.Other.CSRFInput}}<input type="hidden" name="pub_id" value="{{$.Other.PublisherCredentialPubID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input type="number" name="overlap_minutes" min="0" max="10080" value="0" aria-label="重叠分钟数" required><input name="reason" maxlength="255" placeholder="轮换原因" required><button class="btn btn-sm btn-warning">轮换</button></form><form method="post" action="publishercredential?action=revoke" autocomplete="off">{{$.Other.CSRFInput}}<input type="hidden" name="pub_id" value="{{$.Other.PublisherCredentialPubID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input name="reason" maxlength="255" placeholder="撤销原因" required><button class="btn btn-sm btn-danger">撤销</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="5">暂无凭证。</td></tr>{{end}}</tbody></table>{{end}}
{{template "footer" .}}
