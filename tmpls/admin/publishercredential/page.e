{{template "header" .}}
<h1>Publisher request credentials</h1><form class="form-inline" method="get" action="publishercredential"><input type="hidden" name="action" value="topics"><label>Publisher ID <input class="form-control" type="number" min="1" name="pub_id" value="{{.Other.PublisherCredentialPubID}}" required></label> <button class="btn btn-secondary" type="submit">View</button></form>
{{with .Other.IssuedPublisherPrivateValue}}<div class="alert alert-warning"><strong>Private credential shown once; copy it now:</strong><br><code>{{.}}</code></div>{{end}}
{{if .Other.PublisherCredentialListUnavailable}}<div class="alert alert-danger">The credential was issued, but its metadata list could not be refreshed. Preserve the private value above.</div>{{end}}
{{if .Other.PublisherCredentialPubID}}<h2>Issue credential</h2><form method="post" action="publishercredential?action=issue" autocomplete="off">{{.Other.CSRFInput}}<input type="hidden" name="pub_id" value="{{.Other.PublisherCredentialPubID}}"><input class="form-control" type="number" min="1" name="site_id" placeholder="Approved App site ID" required><input class="form-control" name="credential_name" maxlength="128" placeholder="Name" required><input class="form-control" type="number" name="expires_days" min="1" max="365" value="90" required><input class="form-control" name="reason" maxlength="255" placeholder="Reason" required><button class="btn btn-primary" type="submit">Issue</button></form>
<h2>Existing credentials</h2><table class="table table-striped"><thead><tr><th>ID</th><th>App site</th><th>Name / public ID</th><th>Expiry</th><th>State / action</th></tr></thead><tbody>{{range .Other.PublisherCredentials}}<tr><td>{{.ID}}</td><td>{{.SiteID}}</td><td>{{.Name}}<br><code>{{.PublicID}}</code></td><td>{{.ExpiresAt}}</td><td>{{if .RevokedAt}}Revoked{{else if .RotatedAt}}Rotated{{else}}Active{{end}}{{if not .RevokedAt}}<form method="post" action="publishercredential?action=rotate" autocomplete="off">{{$.Other.CSRFInput}}<input type="hidden" name="pub_id" value="{{$.Other.PublisherCredentialPubID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input type="number" name="overlap_minutes" min="0" max="10080" value="0" aria-label="Overlap minutes" required><input name="reason" maxlength="255" placeholder="Rotation reason" required><button class="btn btn-sm btn-warning">Rotate</button></form><form method="post" action="publishercredential?action=revoke" autocomplete="off">{{$.Other.CSRFInput}}<input type="hidden" name="pub_id" value="{{$.Other.PublisherCredentialPubID}}"><input type="hidden" name="credential_id" value="{{.ID}}"><input name="reason" maxlength="255" placeholder="Revocation reason" required><button class="btn btn-sm btn-danger">Revoke</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="5">No credentials.</td></tr>{{end}}</tbody></table>{{end}}
{{template "footer" .}}
