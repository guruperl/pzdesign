{{template "header" .}}<div class="container-fluid"><h1 class="h3">Advertiser funding</h1><p class="text-muted">Stripe-hosted pages collect payment details. W8M stores opaque provider IDs only and never receives full card or bank credentials.</p>{{if .Other.PaymentMessage}}<div class="alert alert-success">{{.Other.PaymentMessage}}</div>{{end}}<h2 class="h5">Create hosted customer</h2><form method="post" action="hostedpayment?action=fundingCustomer">{{.Other.CSRFInput}}<input type="hidden" name="adv_id" value="{{.Other.PaymentScope.PartyID}}"><input class="form-control" name="request_key" maxlength="128" placeholder="Idempotency request key" required><input class="form-control" name="reason" maxlength="500" placeholder="Reason" required><button class="btn btn-outline-danger" type="submit">Create customer</button></form><h2 class="h5 mt-4">Propose statement payment</h2><form method="post" action="hostedpayment?action=proposeFunding">{{.Other.CSRFInput}}<input type="hidden" name="adv_id" value="{{.Other.PaymentScope.PartyID}}"><input class="form-control" type="number" min="1" name="statement_id" placeholder="Confirmed statement ID" required><input class="form-control" name="amount" placeholder="USD amount, exact cents" required><input class="form-control" name="request_key" maxlength="128" placeholder="Idempotency request key" required><input class="form-control" name="reason" maxlength="500" placeholder="Reason" required><button class="btn btn-danger" type="submit">Propose payment</button></form><h2 class="h4 mt-4">Operations</h2><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Kind / statement</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody>{{range .Other.PaymentOperations}}<tr><td>{{.ID}}</td><td>{{.Kind}} / #{{.StatementID}}</td><td>{{.Amount}} {{.Currency}}</td><td>{{.Status}}</td><td>{{if eq .Status "Approved"}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-danger">Open hosted checkout</button></form>{{end}}{{if and (eq .Kind "Funding") (eq .Status "Submitted")}}<form method="post" action="hostedpayment?action=executeOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><button class="btn btn-sm btn-outline-danger">Reopen hosted checkout</button></form>{{end}}{{if or (eq .Status "Proposed") (and (eq .Status "Approved") (eq .AttemptCount 0)) (and (eq .Kind "Funding") (or (eq .Status "Submitted") (eq .Status "Canceling")))}}<form method="post" action="hostedpayment?action=cancelOperation">{{$.Other.CSRFInput}}<input type="hidden" name="operation_id" value="{{.ID}}"><input type="hidden" name="operation_version" value="{{.Version}}"><input name="reason" maxlength="500" placeholder="Cancellation reason" required><button class="btn btn-sm btn-outline-secondary">{{if eq .Status "Canceling"}}Continue cancellation{{else}}Cancel{{end}}</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="5">No hosted operations.</td></tr>{{end}}</tbody></table></div>{{template "footer" .}}
