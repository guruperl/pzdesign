{{ template "header" .}}
<h1 class="h2">Traffic quality review</h1><p class="text-muted">This page shows only the current account or explicitly delegated scope. Infrastructure failures, timeouts, and format errors are not automatically classified as invalid traffic.</p>{{with .Other.QualityMessage}}<div class="alert alert-success">{{.}}</div>{{end}}
{{with .Other.QualityScope}}<p>Review scope: <strong>{{.Type}} {{.ID}}</strong></p>{{end}}
<div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Case</th><th>Rule and signal</th><th>Evidence summary</th><th>Action</th><th>Status</th><th>Appeal</th></tr></thead><tbody>{{range .Other.QualityCases}}<tr><td>#{{.ID}}<br><small>{{.ObservedAt}}</small></td><td><code>{{.RuleKey}}@{{.RuleVersion}}</code><br>{{.Signal}} / {{.ReasonCode}}</td><td>{{.Evidence}}; observed {{printf "%.6f" .ObservedValue}}, threshold {{printf "%.6f" .Threshold}}{{if .SafeSummary.Valid}}<br>{{.SafeSummary.String}}{{end}}</td><td>{{.ConfiguredAction}} → {{.AppliedAction}}</td><td>{{.Status}} (v{{.Version}})</td><td>{{if and $.Other.QualityCanAppeal (eq .Status "InvalidTraffic")}}<form method="post" action="trafficquality?action=appeal">{{$.Other.CSRFInput}}<input type="hidden" name="case_id" value="{{.ID}}"><input type="hidden" name="case_version" value="{{.Version}}"><input type="hidden" name="adv_id" value="{{.Scope.ID}}"><input type="hidden" name="pub_id" value="{{.Scope.ID}}"><input name="reason" maxlength="500" placeholder="appeal reason" required><button class="btn btn-sm btn-outline-primary" type="submit">Submit appeal</button></form>{{else}}—{{end}}</td></tr>{{else}}<tr><td colspan="6">No review cases are available in this scope.</td></tr>{{end}}</tbody></table></div>
<h2 class="h4">Enforcement status</h2><table class="table table-sm"><thead><tr><th>ID</th><th>Action</th><th>State</th><th>Canary</th><th>Expires</th></tr></thead><tbody>{{range .Other.QualityEnforcements}}<tr><td>{{.ID}}</td><td>{{.Action}}</td><td>{{.State}}</td><td>{{.CanaryBasisPoints}} bp</td><td>{{.ExpiresAt}}</td></tr>{{else}}<tr><td colspan="5">No enforcement history.</td></tr>{{end}}</tbody></table>
{{ template "footer" .}}
