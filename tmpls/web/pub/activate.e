{{ template "header" .}}
{{ template "pubheader" }}

<div class="account-card account-card-compact theme-publisher">
  <aside class="account-context">
    <div class="account-context-copy">
      <span class="account-role-mark"><i class="fa fa-check" aria-hidden="true"></i></span>
      <p class="account-eyebrow">Publisher Account</p>
      <h2>Account Activated</h2>
      <p>Your publisher account has been successfully activated.</p>
    </div>
    <div class="account-context-footer"><a href="/goto/pub/e/site?action=topics">Go to Publisher Dashboard</a></div>
  </aside>
  <section class="account-form-panel">
    <div class="account-form-heading">
      <span class="account-kicker">Account Status</span>
      <h1>Account Activated</h1>
      <p>Your email has been verified and your account is ready to use.</p>
    </div>
    <p>You can now log in and start creating traffic sources and ad slots.</p>
  </section>
</div>

{{ template "footer" }}
</body>
</html>
