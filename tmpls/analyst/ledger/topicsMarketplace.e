{{ template "header" .}}<h1>Authorized marketplace report</h1><p>This read-only aggregate view does not expose JSON export, experiment salts, audit reasons, credentials, private contracts, or settlement controls.</p><form method="get" action="ledger"><input type="hidden" name="action" value="topicsMarketplace"><label for="day">Through date</label><input id="day" type="date" name="day" value="{{index .ARGS.day 0}}"><label for="idays">Lookback days</label><input id="idays" type="number" min="0" max="90" name="idays" value="{{index .ARGS.idays 0}}"><label for="top">Rows</label><input id="top" type="number" min="1" max="200" name="top" value="{{index .ARGS.top 0}}"><button type="submit">View</button></form><table class="table"><thead><tr><th>Source</th><th>Advertiser / campaign</th><th>Publisher / site / slot</th><th>Supply categories</th><th>Impressions / clicks</th></tr></thead><tbody>{{range .Lists}}<tr><td>{{.demand_source}}</td><td>{{.adv_id}} / {{.campaign_id}}</td><td>{{.pub_id}} / {{.site_id}} / {{.slot_id}}</td><td>{{.inventory_environment}} / {{.integration_mode}} / {{.placement}} / {{.traffic_quality}} / {{.seller_type}}</td><td>{{.imps}} / {{.clis}}</td></tr>{{end}}</tbody></table>{{ template "footer" .}}
