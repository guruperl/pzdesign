{{ template "header" .}}<div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom"><h1 class="h2">Authorized Marketplace Report</h1></div><div class="card"><div class="card-body"><p>This is a read-only aggregate view. Account identifiers and public supply classifications are available for operational analysis; JSON exports, experiment salts, audit reasons, credentials, private contracts, and settlement controls are not exposed.</p><form method="get" action="ledger"><input type="hidden" name="action" value="topicsMarketplace"><label for="day">Through Date</label><input id="day" type="date" name="day" value="{{index .ARGS.day 0}}"><label for="idays">Lookback Days</label><input id="idays" type="number" min="0" max="90" name="idays" value="{{index .ARGS.idays 0}}"><label for="top">Rows</label><input id="top" type="number" min="1" max="200" name="top" value="{{index .ARGS.top 0}}"><button class="btn btn-primary" type="submit">View</button></form></div></div><div class="card mt-3"><div class="card-body table-responsive"><table class="table table-sm"><thead><tr><th>Source</th><th>Advertiser / Campaign</th><th>Publisher / Traffic Source / Ad Slot</th><th>Traffic Classification / Seller</th><th>Impressions / Clicks</th></tr></thead><tbody>{{range .Lists}}<tr><td>{{.demand_source}}</td><td>{{.adv_id}} / {{.campaign_id}}</td><td>{{.pub_id}} / {{.site_id}} / {{.slot_id}}</td><td>{{.inventory_environment}} / {{.integration_mode}} / {{.placement}} / {{.traffic_quality}} / {{.seller_type}}</td><td>{{.imps}} / {{.clis}}</td></tr>{{end}}</tbody></table></div></div>{{ template "footer" .}}
