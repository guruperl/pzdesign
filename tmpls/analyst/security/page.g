{{ template "header" .}}<h1>账户安全</h1>{{if .Other.Required}}<div class="alert alert-info">只读分析账户必须启用双重验证。完成设置前，报表不可用。</div>{{end}}{{if .Other.Disabled}}<div class="alert alert-success">双重验证已停用，所有会话已撤销。</div>{{end}}{{with .Other.Enrollment}}<div class="alert alert-warning"><p>请将密钥添加到身份验证器。密钥只显示一次。</p><p><strong>设置密钥：</strong><code>{{.Secret}}</code></p><p><strong>TOTP 地址：</strong><code>{{.URI}}</code></p></div><form method="post" action="security">{{$.Other.CSRFInput}}<input type="hidden" name="action" value="confirm"><label for="confirm-code">六位验证码</label><input id="confirm-code" name="totp" pattern="[0-9]{6}" required><button type="submit">确认并启用</button></form>{{end}}{{with .Other.RecoveryCodes}}<div class="alert alert-success"><p><strong>请立即离线保存以下单次使用恢复代码：</strong></p><ul>{{range .}}<li><code>{{.}}</code></li>{{end}}</ul></div>{{end}}<p>状态：{{.Other.MFAState}}；未使用恢复代码：{{.Other.RecoveryRemaining}}</p>{{if eq .Other.MFAState "Disabled"}}<form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="enroll"><button type="submit">设置身份验证器</button></form>{{end}}{{if eq .Other.MFAState "Enabled"}}<form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="rotateRecovery"><label for="rotate-code">当前验证码</label><input id="rotate-code" name="totp" pattern="[0-9]{6}" required><button type="submit">更新恢复代码</button></form><form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="disable"><label for="disable-code">当前验证码</label><input id="disable-code" name="totp" pattern="[0-9]{6}" required><label for="disable-reason">操作原因</label><input id="disable-reason" name="reason" maxlength="255" required><button type="submit">停用并撤销全部会话</button></form>{{end}}{{ template "footer" .}}
