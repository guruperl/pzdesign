{{ template "header" .}}<h1>Account security</h1>{{if .Other.Required}}<div class="alert alert-info">Read-only analyst accounts require two-factor authentication. Reports remain unavailable until enrollment completes.</div>{{end}}{{if .Other.Disabled}}<div class="alert alert-success">Two-factor authentication is disabled and all sessions were revoked.</div>{{end}}{{with .Other.Enrollment}}<div class="alert alert-warning"><p>Add this one-time displayed key to an authenticator.</p><p><strong>Setup key:</strong><code>{{.Secret}}</code></p><p><strong>TOTP URI:</strong><code>{{.URI}}</code></p></div><form method="post" action="security">{{$.Other.CSRFInput}}<input type="hidden" name="action" value="confirm"><label for="confirm-code">Six-digit code</label><input id="confirm-code" name="totp" pattern="[0-9]{6}" required><button type="submit">Confirm and enable</button></form>{{end}}{{with .Other.RecoveryCodes}}<div class="alert alert-success"><p><strong>Save these single-use recovery codes offline now:</strong></p><ul>{{range .}}<li><code>{{.}}</code></li>{{end}}</ul></div>{{end}}<p>Status: {{.Other.MFAState}}; unused recovery codes: {{.Other.RecoveryRemaining}}</p>{{if eq .Other.MFAState "Disabled"}}<form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="enroll"><button type="submit">Set up authenticator</button></form>{{end}}{{if eq .Other.MFAState "Enabled"}}<form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="rotateRecovery"><label for="rotate-code">Current code</label><input id="rotate-code" name="totp" pattern="[0-9]{6}" required><button type="submit">Rotate recovery codes</button></form><form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="disable"><label for="disable-code">Current code</label><input id="disable-code" name="totp" pattern="[0-9]{6}" required><label for="disable-reason">Reason</label><input id="disable-reason" name="reason" maxlength="255" required><button type="submit">Disable and revoke all sessions</button></form>{{end}}{{ template "footer" .}}
