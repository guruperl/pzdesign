{{ template "header" .}}{{ template "pubheader" .}}
<div class="card"><div class="card-header">Account security</div><div class="card-body">{{if .Other.Required}}<div class="alert alert-info">Two-factor authentication is required. Only this page is available until enrollment is complete.</div>{{end}}{{if .Other.Disabled}}<div class="alert alert-success">Two-factor authentication is disabled and all sessions were revoked.</div>{{end}}{{with .Other.Enrollment}}<div class="alert alert-warning"><p>Add this key to an authenticator, then enter the current six-digit code. The key is displayed only once.</p><p><strong>Setup key:</strong> <code>{{.Secret}}</code></p><p><strong>TOTP URI:</strong> <code>{{.URI}}</code></p></div><form method="post" action="security">{{$.Other.CSRFInput}}<input type="hidden" name="action" value="confirm"><label for="security-confirm-code">Six-digit code</label><input id="security-confirm-code" class="form-control" name="totp" pattern="[0-9]{6}" required><button class="btn btn-primary" type="submit">Confirm and enable</button></form>{{end}}{{with .Other.RecoveryCodes}}<div class="alert alert-success"><p><strong>Save these single-use codes offline now.</strong></p><ul>{{range .}}<li><code>{{.}}</code></li>{{end}}</ul></div>{{end}}<p>Status: <strong>{{.Other.MFAState}}</strong>; unused recovery codes: <strong>{{.Other.RecoveryRemaining}}</strong></p>{{if eq .Other.MFAState "Disabled"}}<form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="enroll"><button class="btn btn-primary" type="submit">Set up authenticator</button></form>{{end}}{{if eq .Other.MFAState "Enabled"}}<hr><form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="rotateRecovery"><label for="security-rotate-code">Current six-digit code</label><input id="security-rotate-code" class="form-control" name="totp" pattern="[0-9]{6}" required><button class="btn btn-secondary" type="submit">Generate new recovery codes</button></form><hr><form method="post" action="security">{{.Other.CSRFInput}}<input type="hidden" name="action" value="disable"><label for="security-disable-code">Current six-digit code</label><input id="security-disable-code" class="form-control" name="totp" pattern="[0-9]{6}" required><label for="security-disable-reason">Reason</label><input id="security-disable-reason" class="form-control" name="reason" maxlength="255" required><button class="btn btn-danger" type="submit">Disable and revoke sessions</button></form>{{end}}</div></div>{{ template "footer" .}}
