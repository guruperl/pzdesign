{{template "header" .}}<div class="container-fluid"><h1 class="h3">Publisher payout account</h1><p class="text-muted">Bank details and identity checks stay on Stripe-hosted onboarding. W8M stores only the opaque Connect account ID and two-letter country code.</p>{{if .Other.PaymentMessage}}<div class="alert alert-success">{{.Other.PaymentMessage}}</div>{{end}}<h2 class="h5">Start hosted onboarding</h2><form method="post" action="hostedpayment?action=payoutOnboarding">{{.Other.CSRFInput}}<input type="hidden" name="pub_id" value="{{.Other.PaymentScope.PartyID}}"><input class="form-control" name="country" minlength="2" maxlength="2" value="US" required><input class="form-control" name="request_key" maxlength="128" placeholder="Idempotency request key" required><input class="form-control" name="reason" maxlength="500" placeholder="Reason" required><button class="btn btn-success">Open hosted onboarding</button></form><h2 class="h4 mt-4">Bindings</h2><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Opaque provider ID</th><th>Country</th><th>Ready</th><th>Status</th></tr></thead><tbody>{{range .Other.PaymentBindings}}<tr><td>{{.ID}}</td><td><code>{{.ProviderToken}}</code></td><td>{{if .Country.Valid}}{{.Country.String}}{{else}}—{{end}}</td><td>{{.ProviderReady}}</td><td>{{.Status}}</td></tr>{{else}}<tr><td colspan="5">No payout binding.</td></tr>{{end}}</tbody></table><h2 class="h4">Payout status</h2><table class="table table-sm"><thead><tr><th>ID</th><th>Statement</th><th>Amount</th><th>Status</th></tr></thead><tbody>{{range .Other.PaymentOperations}}<tr><td>{{.ID}}</td><td>#{{.StatementID}}</td><td>{{.Amount}} {{.Currency}}</td><td>{{.Status}}</td></tr>{{else}}<tr><td colspan="4">No payouts.</td></tr>{{end}}</tbody></table></div>{{template "footer" .}}
